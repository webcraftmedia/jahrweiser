[
  {
    "path": ".output/public/_nuxt/*.js",
    "limit": "260 kB",
    "name": "JS bundles"
  },
  {
    "path": ".output/public/_nuxt/*.css",
    "limit": "25 KB",
    "name": "CSS bundles"
  },
  {
    "path": ".output/public/polyfills.js",
    "limit": "1.5 kB",
    "name": "Polyfills (every visitor, before the app)"
  },
  {
    "path": ".output/public/sw.js",
    "limit": "9 kB",
    "name": "Service worker (installed app only, incl. precache list)"
  }
]
