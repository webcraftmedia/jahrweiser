extend ../layout.pug

block content
  .content
  p!= t('emails.requestLoginLink.authenticate',)
  a.button(href=authURL)!= t('emails.requestLoginLink.button')
  p!= t('emails.requestLoginLink.authenticateLink')
    | 
    a.auth(href=authURL)!= authURL
  if code
    p!= t('emails.requestLoginLink.code', { minutes: codeMinutes })
    p.code(style="font-size: 28px; font-weight: bold; letter-spacing: 4px; font-family: monospace;")= code
  p!= t('emails.requestLoginLink.hints', { loginDays })
